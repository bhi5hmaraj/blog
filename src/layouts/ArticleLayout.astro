---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import HypothesisComments from "../components/HypothesisComments.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="subtitle">{post.data.description}</p>}
      <div class="metadata">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        {post.data.tags.map((tag) => <span><a href={`/writing/?tag=${encodeURIComponent(tag)}`}>{tag}</a></span>)}
      </div>
    </header>
    <div class="article-body">
      <Content />
    </div>
    <HypothesisComments />
  </article>
</BaseLayout>
