---
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .map((tag) => ({ tag, count: posts.filter((post) => post.data.tags.includes(tag)).length }))
  .sort((a, b) => a.tag.localeCompare(b.tag));
const archives = [...Map.groupBy(posts, (post) => post.data.date.toISOString().slice(0, 7))]
  .map(([key, archivePosts]) => ({
    key,
    label: archivePosts[0].data.date.toLocaleDateString("en-GB", { month: "long", year: "numeric" }),
    count: archivePosts.length,
    posts: archivePosts,
  }));
---

<BaseLayout title="Writing" description="Essays and notes by Bhishma Raj.">
  <section class="page listing writing-page">
    <h1>Writing</h1>
    <p class="page-intro">Essays, explanations, and things I’m trying to understand.</p>
    <div class="writing-grid">
      <details class="writing-index writing-mobile-index" aria-label="Browse writing">
        <summary>Archives &amp; tags</summary>
        <nav class="writing-archives" aria-label="Archives">
          <h2>Archives</h2>
          <ul>
            {archives.map(({ key, label, count }) => (
              <li><a href={`#archive-${key}`}>{label} ({count})</a></li>
            ))}
          </ul>
        </nav>
        <nav class="writing-tags" aria-label="Tags">
          <h2>Tags</h2>
          <ul>
            <li><a href="/writing/">all <span>{posts.length}</span></a></li>
            {tags.map(({ tag, count }) => (
              <li><a href={`/writing/?tag=${encodeURIComponent(tag)}`} data-tag={tag}>{tag} <span>{count}</span></a></li>
            ))}
          </ul>
        </nav>
      </details>
      <nav class="writing-index writing-sidebar writing-archives" aria-label="Archives">
        <h2>Archives</h2>
        <ul>
          {archives.map(({ key, label, count }) => (
            <li><a href={`#archive-${key}`}>{label} ({count})</a></li>
          ))}
        </ul>
      </nav>
      <div class="writing-results">
        <p class="filtered-heading" data-filter-heading hidden></p>
        {archives.map(({ key, label, posts: archivePosts }) => (
          <section class="archive-group" id={`archive-${key}`}>
            <h2>{label}</h2>
            <PostList posts={archivePosts} />
          </section>
        ))}
      </div>
      <nav class="writing-index writing-sidebar writing-tags" aria-label="Tags">
        <h2>Tags</h2>
        <ul>
          <li><a href="/writing/">all <span>{posts.length}</span></a></li>
          {tags.map(({ tag, count }) => (
            <li><a href={`/writing/?tag=${encodeURIComponent(tag)}`} data-tag={tag}>{tag} <span>{count}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    const tag = params.get("tag");
    if (!tag) return;

    document.querySelectorAll("[data-post-tags]").forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      item.hidden = !JSON.parse(item.dataset.postTags || "[]").includes(tag);
    });

    document.querySelectorAll(".archive-group").forEach((group) => {
      if (group instanceof HTMLElement) group.hidden = !group.querySelector("[data-post-tags]:not([hidden])");
    });

    const heading = document.querySelector("[data-filter-heading]");
    if (heading instanceof HTMLElement) {
      heading.textContent = `Tagged “${tag}”`;
      heading.hidden = false;
    }

    document.querySelectorAll("[data-tag]").forEach((link) => {
      if (link.getAttribute("data-tag") === tag) link.setAttribute("aria-current", "page");
    });
  })();
</script>
