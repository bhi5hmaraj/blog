---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: (CollectionEntry<"posts"> | CollectionEntry<"projects">)[];
  basePath?: "writing" | "projects";
}

const { posts, basePath = "writing" } = Astro.props;
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li data-post-tags={JSON.stringify(post.data.tags)} data-post-archive={post.data.date.toISOString().slice(0, 7)}>
        <a href={`/${basePath}/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {(post.data.draft || post.data.tags.length > 0) && (
          <ul class="post-tags" aria-label="Tags">
            {post.data.draft && <li><span class="draft-badge">draft</span></li>}
            {post.data.tags.map((tag) => (
              <li><a class:list={{ "ai-badge": tag === "handwritten" || tag === "ai-assisted", "quick-take-badge": tag === "quick-takes" }} href={`/${basePath}/?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
            ))}
          </ul>
        )}
        {post.data.description && <p>{post.data.description}</p>}
      </li>
    ))
  }
</ol>
